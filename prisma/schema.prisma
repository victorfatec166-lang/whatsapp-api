datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          String   @id @default(uuid())
  clientPhone String
  clientName  String?
  items       String
  total       Float
  status      String   @default("pendente")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Config {
  id            String   @id @default("default")
  originAddress String
  feePerKm      Float    @default(2.50)
  baseFee       Float    @default(3.00)
  googleApiKey  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}