# Configuracao do sistema.
#
# Copie este arquivo para ".env" e ajuste o que precisar. O ".env" nao entra no
# git -- e' a configuracao da SUA maquina, e a mesma configuracao em outro
# lugar e' outro sistema.
#
#     copy .env.example .env
#
# Apague as linhas que nao usar. Tudo aqui e' opcional, com uma excecao
# marcada abaixo.

# ---------------------------------------------------------------------------
# OBRIGATORIO
# ---------------------------------------------------------------------------

# Onde fica o banco. O caminho e' relativo a pasta "prisma", entao este valor
# aponta para prisma/dev.db.
#
# O arquivo NAO vem com a instalacao e precisa ser criado na primeira vez:
#     npx prisma migrate deploy
#
# Para um caminho absoluto (util quando o banco fica em outro disco):
# DATABASE_URL="file:D:/dados/marmitaria.db"
DATABASE_URL="file:./dev.db"


# ---------------------------------------------------------------------------
# OPCIONAL, MAS LEIA ANTES DE USAR O MARKETPLACE
# ---------------------------------------------------------------------------

# Chave usada para CIFRAR a credencial de iFood e 99Food, antes de gravar no
# banco. Sem ela, a aba Marketplace recusa a credencial e nao guarda nada em
# claro -- a tela mostra o aviso e o botao nao funciona.
#
# O que ela protege: a credencial do parceiro no banco, e a assinatura dos
# webhooks. O que ela NAO protege: quem chega no painel. Isso e' senha, e
# senha ainda nao tem.
#
# Gere um valor unico, com no minimo 32 caracteres:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Trocar esse valor depois torna as credenciais ja gravadas ilegiveis: a
# decifra falha e a conta volta para "sem credencial", que e' o estado honesto.
# A tela explica isso em tela no momento em que acontece.
# CHANNEL_SECRET="cole-aqui-o-valor-gerado"


# ---------------------------------------------------------------------------
# OPCIONAL
# ---------------------------------------------------------------------------

# Porta do painel e da API. A padrao e' 3000.
# PORT=3000

# Endereco que o painel escuta. Padrao e' todas as interfaces, o que permite
# acesso pela rede local -- que e' o que o dono da loja precisa, mas tambem
# significa que qualquer maquina da mesma rede chega no painel sem senha.
#
# Para uso so nesta maquina, comente a linha e descomente a de baixo.
# listening em 127.0.0.1 deixa de expor o caixa e as conversas na rede.
# HOST=0.0.0.0
# HOST=127.0.0.1
