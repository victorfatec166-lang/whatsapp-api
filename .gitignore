node_modules/
dist/
.env
auth_info_baileys/
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
uploads/

# A sessao do WhatsApp inclui o arquivo de amarracao da maquina
# (sessao-maquina.json, escrito por src/services/maquina.ts), que e' a marca de
# que esta instalacao ja foi pareada em algum aparelho. Versionado, ele faria a
# instalacao recusar de arrancar no celular ou no PC da loja -- que e' o que o
# guard existe para impedir. A pasta auth_info_baileys/ acima ja cobre esse
# arquivo; esta linha e' a segunda rede, caso o arquivo passe a ser escrito
# fora dela.
sessao-maquina.json

# Configuracao do editor: entra o que o projeto precisa que everyone tenha, e
# nao o que e' preferencia de quem esta na maquina. Hoje e' uma coisa so, o
# silencio do aviso de @tailwind, que e' falso positivo para qualquer pessoa que
# abrir o projeto. Preferencia pessoal fica em User, nao aqui.
.vscode/*
!.vscode/settings.json

# Copias do banco geradas pelo src/services/backup.ts. Sao artefato local de
# maquina: nao pertencem ao repositorio e nao fazem sentido em outro clone.
backups/

# Scripts de manutencao de uso unico (substituem texto em arquivos-fonte).
# Nao fazem parte do aplicativo. Apenas estas pastas sao descartadas; o que
# estiver solto em scripts/ e ferramenta real e entra no versionamento.
scripts/add/
scripts/apply/
scripts/check/
scripts/find/
scripts/fix/
scripts/insert/
scripts/misc/

# Diretorio chamado "~" na raiz: 51 GB e 478 mil arquivos.
#
# Nao serve a nada aqui. Entrei no repositorio em dez/2025, criado por ferramenta
# externa, e e' uma COPIA do perfil do usuario -- AppData, .config, .local, .vscode,
# omniroute-app e opencode-app. Pior: vinha acompanhado de 97 junctions apontando
# para Downloads, Documents e Pictures de verdade.
#
# Por que esta linha e' obrigatoria e nao e' sujeira: sem ela o git via o diretorio
# como "??", e um `git add -A` versionava o perfil inteiro -- incluindo a chave do
# provedor em .config e o token da Anthropic em .claude. Isso nao e' backup que se
# descarte depois; e' historico do git, que precisa de reescrita para sumir.
# Ja foi removido do disco em 29/09/2026, com as copias reais do perfil conferidas
# antes e depois. A linha fica para o proximo `~` que aparecer.
~/

# Configuracao local do Claude Code
.claude/settings.local.json
# Log do dia, gerado por src/services/logger.ts. Arquivo local da maquina.
logs/

# O instalador montado. `payload` e' a copia de producao do programa (274 MB,
# 4.500 arquivos, com o node.exe dentro), `build` e' o configurador compilado que
# o `.iss` le, e `release` e' o instalador final. Sao artefatos de build: o
# codigo que os produz e' montar.ps1, compilar-instalador.ps1 e
# DeliveryAdmin.cs, e todos versionados. Versionar 274 MB no git deixaria o
# historico inchado de um jeito que nao volta atras.
#
# `installer/dist/` e' `installer/entrega/` nao existem mais: eram a via do ZIP,
# morta em favor do Inno Setup. Ficam aqui para o caso de reaparecerem por uma
# ferramenta antiga -- sao resquicio, e o que esta dentro e' de 101 MB.
installer/payload/
installer/dist/
installer/build/
installer/entrega/
release/

# Cliente de desktop montado: a pasta com o runtime do Electron (300 MB), o zip
# que o servidor entrega no download e o instalador que o electron-builder gera.
# Sao build, e nao dado do dono.
saida-cliente/
cliente-dist/
release-cliente/

# O electron-builder roda `npm install` no `cliente/` (ele e' o projectDir do
# instalador) e cria um lock la. O app nao tem dependencia nenhuma -- o Electron
# esta no package.json do servidor --, entao esse lock nao versiona.
cliente/package-lock.json

# Artefatos do banco local (SQLite), usados pelo instalador do cliente.
#
# `schema.local.prisma` e' GERADO do schema.prisma por scripts/preparar-banco-local.mjs
# e nunca editado a mao: versionar os dois faria os modelos divergirem sem ninguem
# perceber. O banco inicial tambem e' build, e nao dado -- quem tem dado esta em
# %APPDATA%, que nao entra no git.
prisma/schema.local.prisma
cliente/banco-inicial.db

# O sistema empacotado para o instalador (65 MB): dist + dependencias de producao.
# Montado por scripts/montar-servidor.mjs e reproduzivel com `npm run build`.
cliente/servidor/

# A senha do primeiro acesso, quando o `DELIVERYADMIN_DATA` aponta para a raiz.
# normally fica em %APPDATA%, mas quem roda com a pasta na raiz acabaria versionando
# uma senha de administrador em texto claro.
primeiro-acesso.json