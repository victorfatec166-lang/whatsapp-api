# Configuracao do sistema.
#
# Copie este arquivo para ".env" e ajuste o que precisar. O ".env" nao entra no
# git -- e' a configuracao da SUA maquina, e a mesma configuracao em outro
# lugar e' outro sistema.
#
#     copy .env.example .env
#
# Apague as linhas que nao usar. Tudo aqui e' opcional, com uma excecao
# marcada abaixo.

# ---------------------------------------------------------------------------
# OBRIGATORIO
# ---------------------------------------------------------------------------

# Onde fica o banco: um Postgres, e nao mais um arquivo.
#
# O banco local (SQLite) servia enquanto o sistema rodava na maquina do dono. Na
# nuvem o arquivo nao sobrevive ao deploy, entao o dado tem que estar num Postgres
# gerenciado -- Supabase, Neon, RDS, o do Render.
#
# A string vem do painel do seu banco. No Supabase: Settings > Database >
# Connection string > URI. Use a senha real no lugar de SENHA.
#
# NO SUPABASE, PEGUE A LINHA DO POOLER, e nao a do "direct connection". E' a
# unica diferença de pratica entre as duas, e ela decide se o deploy sobe:
#
#   direto   postgresql://postgres:SENHA@db.abc123.supabase.co:5432/postgres
#   pooler   postgresql://postgres.abc123:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#
# O host direto so tem IPv6 (AAAA, sem registro A). Sua maquina Windows alcança
# por causa do IPv6; o container do Render nao tem IPv6 e morre com "P1001: Can't
# reach database server" -- que parece senha errada e nao e. O pooler tem IPv4.
# Repare tambem no "postgres." antes do id do projeto: so no pooler ele existe.
#
# A regiao (sa-east-1 no exemplo) e' a do SEU projeto, e sai na mesma tela.
#
# Nao coloque senha com @, :, / ou # sem codificar: o Prisma nao entende a URL
# e a conexao falha sem mensagem util.
#
# Na nuvem, cadastre isto em Environment Variables. O Prisma le a VARIAVEL, e nao
# o arquivo -- por isso o start funciona sem .env no Render.
#
# Primeira vez com o banco vazio:
#     npx prisma migrate deploy
#
DATABASE_URL="postgresql://usuario:SENHA@host:5432/banco?sslmode=require"


# ---------------------------------------------------------------------------
# OPCIONAL, MAS LEIA ANTES DE USAR O MARKETPLACE
# ---------------------------------------------------------------------------

# Chave usada para CIFRAR a credencial de iFood e 99Food, antes de gravar no
# banco. Sem ela, a aba Marketplace recusa a credencial e nao guarda nada em
# claro -- a tela mostra o aviso e o botao nao funciona.
#
# O que ela protege: a credencial do parceiro no banco, e a assinatura dos
# webhooks. O que ela NAO protege: quem chega no painel. Isso e' senha, e
# senha ainda nao tem.
#
# Gere um valor unico, com no minimo 32 caracteres:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Trocar esse valor depois torna as credenciais ja gravadas ilegiveis: a
# decifra falha e a conta volta para "sem credencial", que e' o estado honesto.
# A tela explica isso em tela no momento em que acontece.
# CHANNEL_SECRET="cole-aqui-o-valor-gerado"


# ---------------------------------------------------------------------------
# OBRIGATORIO NO SAAS: preco da mensalidade e teste
# ---------------------------------------------------------------------------

# O que o dono paga por mes, e o nome do plano que aparece na cobranca.
#
# SAO DO SERVIDOR, e nao do formulario: se o preco viesse do navegador, qualquer um
# criaria a loja pagando um centavo -- e a assinatura e' o produto inteiro. Sem o
# VALOR_MENSAL o cadastro responde 503 e nenhuma loja nova nasce.
#
#   VALOR_MENSAL=19.99
#   PLANO_PADRAO="DeliveryAdmin Beta"
VALOR_MENSAL=""
PLANO_PADRAO=""

# Dias de uso SEM pagar. A loja nasce ligada e o acesso e' cortado sozinho na
# virada do dia em que o prazo acaba -- e' o que separa "teste" de "gratis para
# sempre", e a loja que mais usaria o sistema sem isto seria a que menos pagaria.
#
# O primeiro vencimento no Asaas e' a MESMA data do fim do teste: com 14 dias, a
# primeira cobranca cai no dia 14, e nao antes. TESTE_DIAS=0 desliga o periodo, e
# ai a loja so abre com a mensalidade paga.
TESTE_DIAS=14


# ---------------------------------------------------------------------------
# OPCIONAL
# ---------------------------------------------------------------------------

# O painel de administracao (`/ops`): a lista de lojas, desligar acesso e criar
# conta sem assinatura. Esta e' a tela que mostra os dados de TODOS os clientes,
# entao ela so liga com duas condicoes:
#
#   1. OPS_LIGADO=1            -- sem esta linha a rota responde 404 ate no localhost
#   2. a origem estiver na SAIDA_ADMIN_IP -- que por padrao e' so o loopback
#
# **NAO LIGUE NO RENDER.** La a origem e' sempre a internet, e a guarda de rede
# nao distingue o dono de qualquer outro visitante. Para desligar la, basta nao
# cadastrar a variavel: e' o padrao.
#
# Saida liberada, separada por virgula. Sem isto, so a propria maquina entra.
#SAIDA_ADMIN_IP="192.168.0.10"
OPS_LIGADO=""

# --------------------------------------------------------------------- Bot
# Lojas que ESTA maquina pode ligar no boot, separadas por virgula. Vazio = todas.
#
# O banco e' o mesmo na nuvem e no PC. Sem esta lista, o Render abre socket das
# lojas de todos os clientes que estao no mesmo banco, e cada uma despeja seu QR
# no log dele. No PC de desenvolvimento voce quer o contrario: subir tudo, para ver
# o bot da loja que esta testando.
#
# A loja do DELIVERYADMIN_TENANT entra sempre, mesmo que nao esteja na lista.
# DELIVERYADMIN_LOJAS="ops-daebf73c,minha-loja"
DELIVERYADMIN_LOJAS=""

# Desenha o QR no terminal, do jeito que o Baileys solto fazia. Fora daqui o QR
# so vive no painel: ele renova a cada 30s e, impresso, enterra o log do Render
# em blocos -- escondendo o codigo 408, o logout e o erro de banco, que importam.
#BOT_QR_NO_TERMINAL="1"
BOT_QR_NO_TERMINAL=""

# Porta do painel e da API. A padrao e' 3000.
# PORT=3000

# Endereco que o painel escuta. Padrao e' todas as interfaces, o que permite
# acesso pela rede local -- que e' o que o dono da loja precisa, mas tambem
# significa que qualquer maquina da mesma rede chega no painel sem senha.
#
# Para uso so nesta maquina, comente a linha e descomente a de baixo.
# listening em 127.0.0.1 deixa de expor o caixa e as conversas na rede.
# HOST=0.0.0.0
# HOST=127.0.0.1


# ---------------------------------------------------------------------------
# OPCIONAL: IA no bot
# ---------------------------------------------------------------------------

# A IA ajuda a entender a frase do cliente ("queria um lanche com Coca 2L").
# Ela NAO escolhe o produto, NAO fala de dinheiro e NAO fecha o pedido: o
# produto sai do catalogo e o preco e' relido do banco na hora de fechar.
#
# Sem estas linhas o bot funciona igual, so que por regras de texto. A IA so e'
# chamada quando as regras nao entendem a frase -- quem escreve o nome exato do
# produto nunca gasta uma chamada de rede.
#
# Endpoint no formato OpenAI. Qualquer um destes da para usar:
#   Groq        https://api.groq.com/openai/v1/chat/completions
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions
#   Together    https://api.together.xyz/v1/chat/completions
#   Local       http://127.0.0.1:11434/v1/chat/completions  (Ollama, sem chave)
#
# MODELO tem que existir NAQUELE servico. Com a chave na mao, pegue o nome em
# /v1/models. Nos de graca, costuma ser algo como "llama-3.3-70b-versatile".
# BOT_IA_CHAVE="cole-aqui-a-chave"
# BOT_IA_MODELO=""
# BOT_IA_URL="https://api.groq.com/openai/v1/chat/completions"
#
# BOT_IA=off desliga mesmo com a chave no lugar.
#
# AVISO QUE VALE A PENA: com a IA ligada, o texto que o cliente escreve sai da
# sua maquina e vai para o servico acima. Ver o texto do modulo em
# src/services/ia.ts -- ele so manda a lista de produtos e a frase, nunca o
# telefone nem o que o cliente ja pediu antes.
# BOT_IA=off
